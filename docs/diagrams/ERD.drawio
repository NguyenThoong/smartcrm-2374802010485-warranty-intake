        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\nskinparam linetype ortho\nskinparam roundcorner 5\n\nentity \&quot;customer\&quot; as customer {\n  * customer_id : BIGSERIAL &lt;&lt;PK&gt;&gt;\n  --\n  * full_name : VARCHAR(120)\n  * phone : VARCHAR(20) &lt;&lt;UNIQUE&gt;&gt;\n  email : VARCHAR(120)\n  * segment : VARCHAR(20)\n  * created_at : TIMESTAMPTZ\n}\n\nentity \&quot;device\&quot; as device {\n  * device_id : BIGSERIAL &lt;&lt;PK&gt;&gt;\n  --\n  * customer_id : BIGINT &lt;&lt;FK&gt;&gt;\n  * serial_no : VARCHAR(50) &lt;&lt;UNIQUE&gt;&gt;\n  * purchase_date : DATE\n  * warranty_months : INT\n}\n\nentity \&quot;technician\&quot; as technician {\n  * technician_id : BIGSERIAL &lt;&lt;PK&gt;&gt;\n  --\n  * employee_id : VARCHAR(20) &lt;&lt;UNIQUE&gt;&gt;\n  * center_id : BIGINT\n  * level : VARCHAR(20)\n  * is_active : BOOLEAN\n}\n\nentity \&quot;ticket\&quot; as ticket {\n  * ticket_id : BIGSERIAL &lt;&lt;PK&gt;&gt;\n  --\n  * ticket_code : VARCHAR(20) &lt;&lt;UNIQUE&gt;&gt;\n  * customer_id : BIGINT &lt;&lt;FK&gt;&gt;\n  * device_id : BIGINT &lt;&lt;FK&gt;&gt;\n  technician_id : BIGINT &lt;&lt;FK&gt;&gt;\n  * issue_desc : TEXT\n  * priority : VARCHAR(20)\n  * status : VARCHAR(20)\n  * received_at : TIMESTAMPTZ\n  * due_date : TIMESTAMPTZ\n  closed_at : TIMESTAMPTZ\n}\n\nentity \&quot;ticket_status_log\&quot; as log {\n  * log_id : BIGSERIAL &lt;&lt;PK&gt;&gt;\n  --\n  * ticket_id : BIGINT &lt;&lt;FK&gt;&gt;\n  from_status : VARCHAR(20)\n  * to_status : VARCHAR(20)\n  * changed_at : TIMESTAMPTZ\n  * changed_by : VARCHAR(50)\n}\n\n&#39; Quan hệ (Ký pháp chân chim)\ncustomer ||--o{ device : \&quot;sở hữu\&quot;\ncustomer ||--o{ ticket : \&quot;tạo\&quot;\ndevice ||--o{ ticket : \&quot;tiếp nhận\&quot;\ntechnician |o--o{ ticket : \&quot;xử lý\&quot;\nticket ||--o{ log : \&quot;lưu vết\&quot;\n\nnote bottom of ticket\n  &lt;b&gt;INDEX dự kiến:&lt;/b&gt;\n  * idx_ticket_status_due ON (status, due_date) -&gt; Phục vụ US3, US4\n  * idx_customer_phone ON (phone) -&gt; Phục vụ US1 (tra cứu NFR1)\n  * idx_device_serial ON (serial_no) -&gt; Phục vụ US1 (tra cứu NFR1)\n  * idx_log_ticket ON (ticket_id, changed_at)\nend note\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="Ns0MhiwuxsZ4bsWdkM0B-1">
